# Скопируйте в .env и заполните ключ
ANNOTATE_LLM_API_KEY=
ANNOTATE_LLM_MODEL=qwen-plus
ANNOTATE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANNOTATE_LLM_TEMPERATURE=0.1
ANNOTATE_LLM_MAX_CONCURRENCY=4
ANNOTATE_LLM_MAX_RETRIES=3
ANNOTATE_LONG_PRESENTATION_SLIDES=50
ANNOTATE_LOG_LEVEL=INFO
